# false for direct HTTP. Set true when exclusively accessing through HTTPS.
COOKIE_SECURE=false
# Recording budgets, disk-free reserve, and optional server retention.
CAPTURE_BUDGET_BYTES=21474836480
CAPTURE_ACCOUNT_BUDGET_BYTES=10737418240
CAPTURE_RESERVE_BYTES=1073741824
CAPTURE_RETENTION_DAYS=0

# Optional exact origins allowed to resolve to private LAN addresses.
# Example: https://radio.prendie.io (no path); defaults to public-only radio.
RADIO_PRIVATE_ORIGINS=
